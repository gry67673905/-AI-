<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <WebView
        android:id="@+id/digitalHumanWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAutofill="noExcludeDescendants" />

    <LinearLayout
        android:id="@+id/digitalHumanStatusPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#EFFFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ProgressBar
            android:id="@+id/digitalHumanProgress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/digitalHumanStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/digital_human_preparing"
            android:textColor="#1A2433"
            android:textSize="14sp" />

        <Button
            android:id="@+id/digitalHumanClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/digital_human_close" />
    </LinearLayout>
</FrameLayout>
