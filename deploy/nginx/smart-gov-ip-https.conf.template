limit_req_zone $binary_remote_addr zone=smartgov_ip_api:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=smartgov_ip_chat:10m rate=12r/m;
limit_req_zone $binary_remote_addr zone=smartgov_ip_metastudio:10m rate=5r/s;
limit_req_zone $binary_remote_addr zone=smartgov_ip_metastudio_sessions:10m rate=1r/s;
limit_conn_zone $binary_remote_addr zone=smartgov_ip_vision_ws:10m;

# MetaStudio authenticates the LLM callback with `secret` and `time_stamp`
# query parameters. Never use $request, $request_uri or $args in this format.
log_format smartgov_ip_metastudio_callback
    'request_id=$request_id remote=$remote_addr method=$request_method '
    'uri=$uri status=$status bytes=$body_bytes_sent request_time=$request_time '
    'upstream_status=$upstream_status';

# WebSocket requests carry the short-lived vision bearer token in a header.
# Keep this format to normalized path metadata only: no request line, URI,
# query string, Authorization header or upstream response headers.
log_format smartgov_ip_vision_ws
    'request_id=$request_id remote=$remote_addr method=$request_method '
    'uri=$uri status=$status bytes=$body_bytes_sent request_time=$request_time '
    'upstream_status=$upstream_status';

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name __PUBLIC_IPV4__;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/smart-gov-acme;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 308 https://__PUBLIC_IPV4__$request_uri;
    }
}

server {
    listen 443 ssl http2 default_server;
    listen [::]:443 ssl http2 default_server;
    server_name __PUBLIC_IPV4__;
    server_tokens off;
    limit_req_status 429;
    error_page 429 = @rate_limit_json;

    ssl_certificate /etc/letsencrypt/live/__PUBLIC_IPV4__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__PUBLIC_IPV4__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:smartgov_ip_tls:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 22m;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    location @rate_limit_json {
        internal;
        default_type application/json;
        add_header Retry-After 60 always;
        # Limit errors from the query-authenticated callback are internally
        # redirected here, so this named location must remain query-safe too.
        access_log /var/log/nginx/smart-gov-rate-limit.log smartgov_ip_metastudio_callback;
        error_log /dev/null crit;
        return 429 '{"error":{"code":"rate_limit_exceeded","message":"请求过于频繁，请稍后重试"}}';
    }

    location = /health/live {
        proxy_pass http://127.0.0.1:__UPSTREAM_PORT__;
        include proxy_params;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
        access_log off;
    }

    location = /health/ready {
        proxy_pass http://127.0.0.1:__UPSTREAM_PORT__;
        include proxy_params;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
        access_log off;
    }

    location = /api/v1/chat/stream {
        limit_req zone=smartgov_ip_chat burst=3 nodelay;
        proxy_pass http://127.0.0.1:__UPSTREAM_PORT__;
        include proxy_params;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location = /api/v1/chat {
        limit_req zone=smartgov_ip_chat burst=3 nodelay;
        proxy_pass http://127.0.0.1:__UPSTREAM_PORT__;
        include proxy_params;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_http_version 1.1;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # The same callback path returns JSON or SSE according to request-body
    # `is_stream`. Query arguments are forwarded for MSS_A verification but
    # deliberately excluded from the dedicated access log above.
    location = /api/v1/integrations/metastudio/llm {
        limit_req zone=smartgov_ip_metastudio burst=10 nodelay;
        client_max_body_size 128k;
        proxy_pass http://127.0.0.1:__UPSTREAM_PORT__;
        include proxy_params;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_connect_timeout 10s;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        access_log /var/log/nginx/smart-gov-metastudio-callback.log smartgov_ip_metastudio_callback;
        # Nginx error entries may include the raw request line. Suppress them
        # on this MSS_A query-authenticated path; upstream status remains in
        # the argument-free dedicated access log and the app emits redacted logs.
        error_log /dev/null crit;
    }

    location = /api/v1/integrations/metastudio/client-sessions {
        limit_req zone=smartgov_ip_metastudio_sessions burst=3 nodelay;
        client_max_body_size 4k;
        proxy_pass http://127.0.0.1:__UPSTREAM_PORT__;
        include proxy_params;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_http_version 1.1;
        proxy_connect_timeout 10s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }

    location = /api/v1/integrations/metastudio/vision-sessions {
        limit_req zone=smartgov_ip_metastudio_sessions burst=3 nodelay;
        client_max_body_size 4k;
        proxy_pass http://127.0.0.1:__UPSTREAM_PORT__;
        include proxy_params;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_connect_timeout 10s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }

    location = /api/v1/integrations/metastudio/vision/ws {
        limit_conn smartgov_ip_vision_ws 2;
        client_max_body_size 1m;
        proxy_pass http://127.0.0.1:__UPSTREAM_PORT__;
        include proxy_params;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        proxy_connect_timeout 10s;
        proxy_read_timeout 1900s;
        proxy_send_timeout 30s;
        access_log /var/log/nginx/smart-gov-vision-ws.log smartgov_ip_vision_ws;
        error_log /dev/null crit;
    }

    location /api/ {
        limit_req zone=smartgov_ip_api burst=30 nodelay;
        proxy_pass http://127.0.0.1:__UPSTREAM_PORT__;
        include proxy_params;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_http_version 1.1;
        # WebSocket upgrades are accepted only by the exact vision route.
        proxy_set_header Upgrade "";
        proxy_set_header Connection "";
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location / {
        return 404;
    }
}
