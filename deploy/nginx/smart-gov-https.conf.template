# These zones are evaluated in Nginx's http context because sites-enabled is
# included from that context. They limit anonymous LLM cost and burst traffic.
limit_req_zone $binary_remote_addr zone=smartgov_api:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=smartgov_chat:10m rate=12r/m;

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 308 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __DOMAIN__;
    server_tokens off;
    limit_req_status 429;
    error_page 429 = @rate_limit_json;

    ssl_certificate /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:smartgov_tls:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 22m;

    add_header Strict-Transport-Security "max-age=86400" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    location @rate_limit_json {
        internal;
        default_type application/json;
        add_header Retry-After 60 always;
        return 429 '{"error":{"code":"rate_limit_exceeded","message":"请求过于频繁，请稍后重试"}}';
    }

    location = /health/live {
        proxy_pass http://127.0.0.1:18000;
        include proxy_params;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
        access_log off;
    }

    location = /health/ready {
        proxy_pass http://127.0.0.1:18000;
        include proxy_params;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
        access_log off;
    }

    location = /api/v1/chat/stream {
        limit_req zone=smartgov_chat burst=3 nodelay;
        proxy_pass http://127.0.0.1:18000;
        include proxy_params;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location = /api/v1/chat {
        limit_req zone=smartgov_chat burst=3 nodelay;
        proxy_pass http://127.0.0.1:18000;
        include proxy_params;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_http_version 1.1;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location /api/ {
        limit_req zone=smartgov_api burst=30 nodelay;
        proxy_pass http://127.0.0.1:18000;
        include proxy_params;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_http_version 1.1;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location / {
        return 404;
    }
}
