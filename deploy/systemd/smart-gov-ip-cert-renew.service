[Unit]
Description=Smart Gov short-lived IP certificate renewal
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/smart-gov-renew-ip-cert
UMask=0077
TimeoutStartSec=10min
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/etc/lego-smart-gov /etc/letsencrypt/live /var/backups/smart-gov-cert /var/www/smart-gov-acme
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
