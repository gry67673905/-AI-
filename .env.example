COMPOSE_PROJECT_NAME=smart-gov-assistant

POSTGRES_DB=smart_gov
POSTGRES_USER=smart_gov
POSTGRES_PASSWORD=replace-with-a-random-password
DATABASE_URL=postgresql+asyncpg://smart_gov:replace-with-a-random-password@postgres:5432/smart_gov

REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=300
MILVUS_URI=http://milvus:19530
MILVUS_COLLECTION=gov_knowledge_v2
MINIO_ROOT_USER=replace-with-a-random-user
MINIO_ROOT_PASSWORD=replace-with-a-random-password
MINIO_ENDPOINT=http://minio:9000
MATERIALS_BUCKET=smart-gov-materials
KNOWLEDGE_BUCKET=smart-gov-knowledge
MAX_MATERIAL_BYTES=10485760

JWT_SIGNING_KEY=replace-with-a-random-signing-key
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
PII_HMAC_KEY=replace-with-a-random-hmac-key
PII_ENCRYPTION_KEY=replace-with-a-random-encryption-key
ENABLE_DEMO_PROVIDERS=true
DEMO_SMS_CODE=000000
DEMO_ADMIN_USERNAME=admin.demo
DEMO_ADMIN_PASSWORD=replace-with-a-random-demo-password
DEMO_STAFF_USERNAME=staff.demo
DEMO_STAFF_PASSWORD=replace-with-a-random-demo-password

MCP_URL=http://mcp-server:3000/mcp
MCP_HEALTH_URL=http://mcp-server:3000/health
MCP_INTERNAL_TOKEN=replace-with-a-random-token
MCP_SESSION_TTL_MS=900000
MCP_MAX_SESSIONS=128
GOV_API_BASE_URL=http://mock-gov-api:8080
GOV_API_TOKEN=replace-with-a-random-token

LLM_MODE=deepseek
LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=replace-with-key-list-value
LOG_LEVEL=INFO
