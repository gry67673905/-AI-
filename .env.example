COMPOSE_PROJECT_NAME=smart-gov-assistant

POSTGRES_DB=smart_gov
POSTGRES_USER=smart_gov
POSTGRES_PASSWORD=replace-with-a-random-password
DATABASE_URL=postgresql+asyncpg://smart_gov:replace-with-a-random-password@postgres:5432/smart_gov

REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=300
MILVUS_URI=http://milvus:19530
MILVUS_COLLECTION=gov_knowledge_v2
MINIO_ROOT_USER=replace-with-a-random-user
MINIO_ROOT_PASSWORD=replace-with-a-random-password
MINIO_ENDPOINT=http://minio:9000
MATERIALS_BUCKET=smart-gov-materials
KNOWLEDGE_BUCKET=smart-gov-knowledge
MAX_MATERIAL_BYTES=10485760
MATERIAL_DOCUMENTS_ENABLED=true
MATERIAL_TEMPLATE_SOURCE_PREFIX=material-templates/v1
MATERIAL_TEMPLATE_MANIFEST_PATH=resources/material_templates/v1/manifest.json
MATERIAL_TEMPLATES_BUCKET=smart-gov-material-templates
GENERATED_DOCUMENTS_BUCKET=smart-gov-generated-documents
MATERIAL_TEMPLATE_PROVIDER=mock
MATERIAL_TEMPLATE_MODEL=qwen3-vl-flash-2026-01-22
MATERIAL_TEMPLATE_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MATERIAL_TEMPLATE_DASHSCOPE_API_KEY=
MATERIAL_DOCUMENT_RETENTION_HOURS=24
MATERIAL_DOCUMENT_USER_DAILY_LIMIT=10
MATERIAL_DOCUMENT_USER_ACTIVE_LIMIT=2
MATERIAL_DOCUMENT_GLOBAL_DAILY_LIMIT=20
MATERIAL_DOCUMENT_GLOBAL_QUEUE_LIMIT=50
MATERIAL_DOCUMENT_WORKER_POLL_SECONDS=1.0
MATERIAL_DOCUMENT_WORKER_LEASE_SECONDS=180
MATERIAL_DOCUMENT_MODEL_TIMEOUT_SECONDS=90

JWT_SIGNING_KEY=replace-with-a-random-signing-key
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
PII_HMAC_KEY=replace-with-a-random-hmac-key
PII_ENCRYPTION_KEY=replace-with-a-random-encryption-key
ENABLE_DEMO_PROVIDERS=true
DEMO_SMS_CODE=000000
DEMO_ADMIN_USERNAME=admin.demo
DEMO_ADMIN_PASSWORD=replace-with-a-random-demo-password
DEMO_STAFF_USERNAME=staff.demo
DEMO_STAFF_PASSWORD=replace-with-a-random-demo-password

MCP_URL=http://mcp-server:3000/mcp
MCP_HEALTH_URL=http://mcp-server:3000/health
MCP_INTERNAL_TOKEN=replace-with-a-random-token
MCP_SESSION_TTL_MS=900000
MCP_MAX_SESSIONS=128
GOV_API_BASE_URL=http://mock-gov-api:8080
GOV_API_TOKEN=replace-with-a-random-token

LLM_MODE=deepseek
LLM_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=replace-with-key-list-value
VISION_ENABLED=true
VISION_PROVIDER=mock
# Only set this when explicitly switching VISION_PROVIDER=dashscope later.
VISION_DASHSCOPE_API_KEY=
VISION_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_DOCUMENT_TIMEOUT_SECONDS=20
# Fast perception stays local/no-egress by default. Set both values only when
# a separately deployed RT-DETR/tracking/action/OCR HTTP worker is available.
VISION_FAST_PROVIDER=mock
VISION_FAST_HTTP_URL=
VISION_FAST_TIMEOUT_SECONDS=0.5
VISION_FAST_MAX_CONCURRENCY=2
VISION_TIMELINE_TTL_SECONDS=120
VISION_TIMELINE_MAX_EVENTS=128
VISION_SEALED_TURN_CAPACITY=2
VISION_LATE_MEMORY_TTL_SECONDS=120
VISION_TURN_CLOSE_WAIT_MS=2000
VISION_ANALYSIS_GLOBAL_DAILY=20
LOG_LEVEL=INFO
